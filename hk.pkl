amends "package://github.com/jdx/hk/releases/download/v1.2.0/hk@1.2.0#/Config.pkl"

local linters = new Mapping<String, Step> {
    ["ruff-format"] {
        check = "uv run --all-packages --frozen ruff format --check ."
        fix = "uv run --all-packages --frozen ruff format ."
    }
    ["ruff"] {
        check = "uv run --all-packages --frozen ruff check ."
        fix = "uv run --all-packages --frozen ruff check --fix ."
    }
    ["pyright"] {
        check = "uv run --all-packages --frozen pyright --warnings"
    }
    ["ty"] {
        check = "uv run --all-packages --frozen ty check --python .venv --error-on-warning"
    }
}

hooks {
    ["pre-commit"] { steps = linters }
    ["pre-push"] { steps = linters }
    ["check"] { steps = linters }
    ["fix"] {
        fix = true
        steps = linters
    }
}
